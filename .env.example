# Copy to .env and fill in. .env is gitignored and must never be committed.

# Meta Model API (https://dev.meta.ai)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
JUDGE_MODEL=muse-spark-1.3

# Muse Spark Open on Baseten (second pass)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
SECOND_PASS_MODEL=meta-models/muse-spark-open-1026

# WhatsApp Cloud API (test number)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v26.0
# App secret, to check that webhook calls really come from Meta
WHATSAPP_APP_SECRET=
# Trusted family contact who has messaged Valerius first (opt-in), digits only
TRUSTED_CONTACT=

# Access code for the web intake page (/check). Leave empty to turn the page off.
INTAKE_CODE=

# Cancel leaked owner dashboard links: links made before this Unix time stop working
DASHBOARD_NOT_BEFORE=0

# Signing key for approval links and receipts (any long random string)
SIGNING_SECRET=
APPROVAL_BASE_URL=http://localhost:8080
